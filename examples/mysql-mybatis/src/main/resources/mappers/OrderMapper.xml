<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.acme.shop.OrderMapper">

  <select id="findForTenant" resultType="map">
    SELECT id, status, total FROM purchase_order WHERE tenant_id = #{tenantId}
  </select>

  <!-- The leak: tenantId is a parameter of the method, but not of the query. -->
  <select id="findByStatus" resultType="map">
    SELECT id, status, total FROM purchase_order WHERE status = #{status}
  </select>
</mapper>
